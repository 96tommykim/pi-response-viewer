{
  "name": "pi-response-viewer",
  "version": "0.2.0",
  "description": "A local, output-only response viewer for Pi.",
  "type": "module",
  "license": "MIT",
  "keywords": ["pi-package"],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/96tommykim/pi-response-viewer.git"
  },
  "homepage": "https://github.com/96tommykim/pi-response-viewer#readme",
  "bugs": {
    "url": "https://github.com/96tommykim/pi-response-viewer/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": ["./extensions/response-viewer/index.ts"]
  },
  "files": [
    "README.md",
    "LICENSE",
    "extensions/response-viewer/index.ts",
    "extensions/response-viewer/state.ts",
    "extensions/response-viewer/server.ts",
    "extensions/response-viewer/client.js",
    "extensions/response-viewer/link-policy.js",
    "extensions/response-viewer/renderer.js",
    "extensions/response-viewer/syntax.js",
    "extensions/response-viewer/mermaid-view.js",
    "extensions/response-viewer/tree-view.js",
    "extensions/response-viewer/fence-renderers.js",
    "extensions/response-viewer/diff-view.js",
    "extensions/response-viewer/json-view.js",
    "extensions/response-viewer/csv-view.js",
    "extensions/response-viewer/tool-step-view.js",
    "extensions/response-viewer/thinking-view.js",
    "extensions/response-viewer/navigator.js",
    "extensions/response-viewer/export-view.js",
    "extensions/response-viewer/template.html",
    "extensions/response-viewer/vendor/*.js",
    "extensions/response-viewer/vendor/LICENSE-*.txt"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "typecheck": "./scripts/link-pi-types.sh && tsc --noEmit -p tsconfig.json",
    "test:unit": "node --experimental-strip-types extensions/response-viewer/test.ts",
    "test:browser": "node --experimental-strip-types extensions/response-viewer/security-test.ts",
    "test": "npm run typecheck && npm run test:unit && npm run test:browser",
    "package:check": "npm pack --dry-run"
  }
}
